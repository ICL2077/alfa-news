# Copy to .env with mode 0600. Never commit credentials.
POSTGRES_USER=news
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=news

PUBLIC_HOST=corpo-news.ci.birlab.ru
BASIC_AUTH_USER=demo
BASIC_AUTH_HASH=generate-with-caddy-hash-password

LLM_MODE=llm
LLM_BASE_URL=https://changellenge.up.railway.app/v1
LLM_API_KEY=replace-with-an-authorized-key
LLM_ENRICH_MODEL=qwen/qwen3.6-35b-a3b
LLM_SCORE_MODEL=qwen/qwen3.6-35b-a3b
LLM_CHAT_MODEL=qwen/qwen3.6-35b-a3b
LLM_EXTRA_BODY={"reasoning":{"enabled":false}}
LLM_JSON_MODE=true
LLM_MAX_TOKENS=2500
LLM_MIN_INTERVAL=1
LLM_CONCURRENCY=2
SCORE_THRESHOLD=0.5
PREFILTER_MIN_HITS=1
NEWS_TEXT_LIMIT=2500

RAG_ENABLED=true
OCR_BACKEND=vlm
LLM_OCR_MODEL=qwen/qwen3-vl-30b-a3b-instruct
OCR_DPI=150
RAG_MIN_SCORE=6.5

BANK_CSV_HOST_DIR=./data/csv
BANK_PDF_HOST_DIR=./data/alfa_pdfs

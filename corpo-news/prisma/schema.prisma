// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Сырые новости из RSS (общий поток, идет в фоне)
model RawArticle {
  id          String   @id @default(uuid())
  guid        String   @unique 
  title       String
  link        String
  description String?
  fullText    String?  @db.Text
  category    String?
  pubDate     DateTime
  processed   Boolean  @default(false) // обработал ли LLM

  sendToStream Boolean @default(false) // отправлена ли новость в JetStream

  createdAt   DateTime @default(now())

  // Связь с результатами фильтрации
  matches     ArticleMatch[]

  @@index([pubDate])
  @@map("raw_articles")
}

model Company {
  id            String   @id @default(uuid())
  inn           String?  @unique // опционально - мб через Dadata поддягивать
  name          String   // будет вводится на сайте пользователем
  description   String?  // будет вводится на сайте пользователем, может помочь LLm получше обогатить инфой "профиль" компании
  okved         String?  // Из dadata
  region        String?  // Из dadata
  keywords      String[] @default([])// Это будет заполнятся LLM-кой
  profileJson   Json?    // полный профиль: поставщики, конкуренты, риски (будет заполнятся LLm)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  status        ProfileStatus @default(DRAFT) // статус профиля (пока LLm не соберет всю нужную инфу о компании профиль будет значится как DRAFT)

  // Связь с отфильтрованными новостями
  matches       ArticleMatch[]

  @@map("companies")
}

// Новости которые подошли компании с результатом скоринга(по важности)
model ArticleMatch {
  id            String   @id @default(uuid())
  rawArticle    RawArticle @relation(fields: [rawArticleId], references: [id], onDelete: Cascade)
  rawArticleId  String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String
  category     String?
  score         Float    // оценка важности 0-1 или 1-10
  summary       String?  @db.Text // саммари от LLM
  explanation   String?  @db.Text // почему это важно для компании
  createdAt     DateTime @default(now())

  // Одна новость может быть релевантна для нескольких компаний, но для одной — только один раз
  @@unique([rawArticleId, companyId])
  @@index([companyId, score])
  @@map("article_matches")
}

enum ProfileStatus {
  DRAFT
  READY
}
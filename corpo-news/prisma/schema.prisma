// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}


// 1. Сырые новости из RSS (общий поток)
model RawArticle {
  id          String   @id @default(uuid())
  guid        String   @unique 
  title       String
  link        String
  description String?
  fullText    String?  @db.Text
  category    String?
  pubDate     DateTime
  processed   Boolean  @default(false) // обработал ли LLM

  sendToStream Boolean @default(false) // отправлена ли новость в JetStream

  createdAt   DateTime @default(now())

  // Связь с результатами фильтрации
  matches     ArticleMatch[]

  @@index([pubDate])
  @@map("raw_articles")
}

// 2. Профиль компании (из DaData + LLM)
model Company {
  id            String   @id @default(uuid())
  inn           String   @unique
  name          String
  okved         String?
  region        String?
  keywords      String[] // ключевые слова, сгенерированные LLM
  profileJson   Json?    // полный профиль: поставщики, конкуренты, риски
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Связь с отфильтрованными новостями
  matches       ArticleMatch[]

  @@map("companies")
}

// 3. Связь «новость ↔ компания» с результатом скоринга
model ArticleMatch {
  id            String   @id @default(uuid())
  rawArticle    RawArticle @relation(fields: [rawArticleId], references: [id], onDelete: Cascade)
  rawArticleId  String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String
  score         Float    // оценка важности 0-1 или 1-10
  summary       String?  @db.Text // саммари от LLM
  explanation   String?  @db.Text // почему это важно для компании
  isRelevant    Boolean  @default(false)
  createdAt     DateTime @default(now())

  // Одна новость может быть релевантна для нескольких компаний, но для одной — только один раз
  @@unique([rawArticleId, companyId])
  @@index([companyId, score])
  @@map("article_matches")
}